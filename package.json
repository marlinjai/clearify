{
  "name": "@marlinjai/clearify",
  "publishConfig": {
    "access": "public"
  },
  "version": "2.2.2",
  "description": "An open-source documentation site generator. Turn markdown into beautiful docs.",
  "type": "module",
  "bin": {
    "clearify": "./bin/clearify.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/types/index.d.ts",
      "import": "./dist/node/types/index.js"
    },
    "./config": {
      "types": "./dist/node/core/config.d.ts",
      "import": "./dist/node/core/config.js"
    },
    "./config-schema.json": "./dist/config-schema.json"
  },
  "files": [
    "bin",
    "dist",
    "src/client",
    "src/theme"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/generate-schema.mjs",
    "dev:self": "node bin/clearify.js dev",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "check:roadmap": "npx --yes github:marlinjai/actions-shared#roadmap-check-v1 --root ."
  },
  "dependencies": {
    "@inquirer/password": "^5.2.5",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@scalar/openapi-parser": "^0.10.17",
    "@shikijs/rehype": "^3.23.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "cac": "^6.7.14",
    "clsx": "^2.1.1",
    "flexsearch": "^0.8.212",
    "globby": "^16.2.4",
    "gray-matter": "^4.0.3",
    "libsodium-wrappers": "^0.8.4",
    "mermaid": "^12.3.0",
    "postcss": "^8.5.32",
    "react-router-dom": "^7.18.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0",
    "vite": "^6.4.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "puppeteer": ">=22.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "puppeteer": "^25.16.0",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "license": "MIT",
  "author": "MarlinJai",
  "repository": {
    "type": "git",
    "url": "https://github.com/marlinjai/clearify.git"
  },
  "homepage": "https://github.com/marlinjai/clearify",
  "bugs": {
    "url": "https://github.com/marlinjai/clearify/issues"
  },
  "keywords": [
    "documentation",
    "docs",
    "markdown",
    "mdx",
    "static-site-generator",
    "vite",
    "react",
    "mermaid",
    "openapi"
  ]
}
